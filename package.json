{
	"name": "dylanskinner65.github.io",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"format": "biome format --write src/",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"lint-staged": {
		"src/**/*.{js,ts,jsx,tsx,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@heroui/styles": "^3.2.6",
		"@supabase/supabase-js": "^2.117.3",
		"@tailwindcss/postcss": "^4.3.3",
		"cmdk": "^1.1.1",
		"framer-motion": "^12.42.2",
		"fuse.js": "^7.5.0",
		"katex": "^0.19.0",
		"lucide-react": "^1.56.0",
		"postcss": "^8.5.30",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.18.4",
		"react-syntax-highlighter": "^16.1.2",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"tailwindcss": "^4.2.1",
		"unist-util-visit": "^5.1.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^24.10.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitejs/plugin-react": "^5.1.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"typescript": "~5.9.3",
		"vite": "^8.0.0-beta.13"
	},
	"overrides": {
		"vite": "^8.0.0-beta.13"
	}
}
